#
# Site settings for the server. Copy to ~/isprinklr-data/server.env and fill
# in. Read by the systemd unit and by `npm run backup`; not committed.

# The sprinkler controller. The web UI reaches it through this server, and the
# nightly backup reads it. Leave empty to turn both off.
ISPRINKLR_ESP_URL=http://192.0.2.10

# Optional; these are the defaults.
ISPRINKLR_HTTP_PORT=8080
ISPRINKLR_UDP_PORT=5514
